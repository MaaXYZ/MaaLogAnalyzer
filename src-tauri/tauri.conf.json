{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaaLogAnalyzer",
  "version": "3.7.0",
  "identifier": "com.maa.log-analyzer",
  "build": {
    "beforeDevCommand": "corepack pnpm@10.34.5 run dev",
    "beforeBuildCommand": "corepack pnpm@10.34.5 run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2025 Windsland52",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "MAA Framework Sink log visualization analysis tool, providing task flow analysis, and failure diagnosis.",
    "shortDescription": "Maa Log Analyzer",
    "targets": ["msi", "dmg", "deb"]
  },
  "app": {
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:"
        ],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ws://localhost:5173",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:"
        ],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'none'"]
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "MaaLogAnalyzer",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ]
  }
}
