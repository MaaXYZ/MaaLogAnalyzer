{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Allow the main window to access dialog and file system APIs used by the desktop log analyzer.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:app:allow-tauri-version",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-exists",
    "fs:allow-lstat",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
